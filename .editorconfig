# Conventions de code appliquées automatiquement (dotnet format) et vérifiées en CI.
# C'est le socle de « l'industrialisation » : tout le monde — humains comme IA —
# produit du code au même format, sans discussion.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
# 'var' seulement quand le type est évident à la lecture.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# Membres sur une seule expression (=>) autorisés.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
# Usings System.* en premier, triés.
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
# Rendre obligatoires les accolades pour éviter les erreurs de portée.
csharp_prefer_braces = true:suggestion

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

# syntax=docker/dockerfile:1
# Frontend Blazor (AppCatalog.Web). Voir Dockerfile pour l'API.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

COPY AppCatalog.sln ./
COPY src/AppCatalog.Web/AppCatalog.Web.csproj src/AppCatalog.Web/
RUN dotnet restore src/AppCatalog.Web/AppCatalog.Web.csproj

COPY . .
RUN dotnet publish src/AppCatalog.Web/AppCatalog.Web.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app ./

EXPOSE 8080
ENV ASPNETCORE_HTTP_PORTS=8080

ENTRYPOINT ["dotnet", "AppCatalog.Web.dll"]
